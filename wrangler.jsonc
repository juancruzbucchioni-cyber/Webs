{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "webs",
  "account_id": "5719397dc42b7c622c08671e86bdc34e",
  "compatibility_date": "2026-08-08",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "./worker/index.ts",
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  },
  "images": {
    "binding": "IMAGES"
  }
}
